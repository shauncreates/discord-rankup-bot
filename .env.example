# ── Discord app (developer portal → your application) ──────────────────
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# OAuth2 client, used for dashboard login (same application, OAuth2 tab)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── NextAuth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Database (Neon Postgres) ────────────────────────────────────────
# Neon gives you both of these when you create a project / the Vercel
# integration sets them automatically.
DATABASE_URL=
DIRECT_URL=

# ── Cron protection ──────────────────────────────────────────────────
# Vercel automatically sends this as a Bearer token to your cron routes
# when this env var is set. Generate with: openssl rand -hex 32
CRON_SECRET=

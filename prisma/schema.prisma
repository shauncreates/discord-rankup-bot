generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  PENDING
  PROMOTED
  DENIED
}

// One row per Discord server the bot has been configured in.
model Guild {
  id                   String        @id // Discord guild (server) snowflake ID
  name                 String? // cached display name, set on setup
  rankerRoleId         String? // role allowed to click rank/deny buttons
  forumChannelId       String? // forum channel where applications must be submitted
  reapplyCooldownHours Int           @default(24) // hours a denied applicant must wait before reapplying
  questions            Question[]
  ranks                Rank[]
  applications         Application[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// A custom form field shown in the application modal. Up to 3 per server —
// enforced in the dashboard UI and the API route, not here.
model Question {
  id       String @id @default(cuid())
  guildId  String
  guild    Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  label    String
  position Int    @default(0)

  @@index([guildId])
}

// One rank button (e.g. "Gold Editor" -> a role).
model Rank {
  id       String  @id @default(cuid())
  guildId  String
  guild    Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  label    String
  roleId   String
  emoji    String?
  position Int     @default(0)

  @@index([guildId])
}

// One submitted application — doubles as the audit log and the source data
// for the stats page.
model Application {
  id                String            @id @default(cuid())
  guildId           String
  guild             Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  applicantId       String
  threadId          String?
  status            ApplicationStatus @default(PENDING)
  answers           Json // [{ label: string, value: string }]
  assignedRankLabel String? // snapshot of the rank label at decision time
  reviewerId        String?
  reason            String? // optional note when denied
  createdAt         DateTime          @default(now())
  reviewedAt        DateTime?

  @@index([guildId])
  @@index([guildId, applicantId])
}

// A scheduled cleanup job for an application thread, checked by the cron route.
model PendingThreadDeletion {
  id        String   @id @default(cuid())
  guildId   String
  channelId String // the thread ID to delete
  deleteAt  DateTime

  @@index([deleteAt])
}
